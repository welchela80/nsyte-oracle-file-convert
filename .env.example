# Copy to .env and set DUMP_DIR. docker compose + the pipeline read these.

# Absolute path to the folder holding the .dmp files (bind-mounted read-only into Oracle at /dumps).
#
#   Linux server:                a normal local path, e.g.  /data/oracle_dumps
#   Windows + Docker Desktop/WSL2: put the dumps ON THE WSL FILESYSTEM and use a Linux path,
#                                  e.g.  /home/USER/dumps  — the /mnt/c Windows mount is slow and
#                                  can HANG on large dumps. Run `docker compose` from WSL so the
#                                  Linux path resolves. (See docs/RUNNING.md.)
DUMP_DIR=/home/USER/dumps

# Oracle SYS/SYSTEM password for the local staging DB (throwaway, local only).
ORACLE_PASSWORD=oracle

# Target PostgreSQL credentials (the converted data lands here).
PG_USER=nmd
PG_PASSWORD=nmd
PG_DB=nmd
